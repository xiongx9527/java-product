# server.sh 会自动 source 本文件（如不需要可删除）。
# 在此集中配置 askdata-server jar 运行所需环境变量；也可在调用前自行 export 覆盖。

# 必填：落库加密密钥（生产必须所有实例一致）
ASKDATA_SECRET_KEY=change-me

# 数据源 profile：mysql / postgresql / cluster / 留空=H2
SPRING_PROFILES_ACTIVE=mysql
ASKDATA_DB_URL=jdbc:mysql://127.0.0.1:3306/askdata?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true
ASKDATA_DB_USERNAME=askdata
ASKDATA_DB_PASSWORD=change-me

# Redis（开启 redis 缓存/会话/集群锁时填写）
ASKDATA_REDIS_HOST=127.0.0.1
ASKDATA_REDIS_PORT=6379
ASKDATA_REDIS_PASSWORD=

# 缓存与会话：memory（默认）/ redis / none
ASKDATA_CACHE_TYPE=memory
# Sa-Token 会话存储：留空跟随上方 type / redis
ASKDATA_SA_TOKEN_STORE=

# 对象存储：local（默认）/ minio / aliyun-oss / amazon-s3 / tencent-cos
FILE_STORAGE_PLATFORM=local

# —— AI 模型（问数/助手/语义召回）——
# 本地 embedding 模型目录（约 793MB，需自行放置；缺失自动降级词法召回）
ASKDATA_EMBEDDING_MODEL_PATH=/opt/askdata/models
# 向量存储后端：qdrant / none（默认，DB JSON 列 + 应用内余弦）
ASKDATA_VECTOR_STORE_TYPE=qdrant
ASKDATA_QDRANT_URL=http://127.0.0.1:6333
ASKDATA_QDRANT_GRPC_PORT=6334
ASKDATA_VECTOR_RECALL_THRESHOLD=0.4
# 注：LLM / 远程 embedding 的真实连接信息（apiDomain/baseModel/apiKey）在「系统 -> AI 模型」界面配置，不在此硬编码。
