<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiongx9527</groupId>
        <artifactId>askdata</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>askdata-server</artifactId>
    <packaging>jar</packaging>

    <name>askdata server</name>
    <description>问数单体后端（Spring Boot 3.5.8，前后端一体：前端 dist 经资源目录挂入 static）。</description>

    <properties>
        <maven.test.skip>true</maven.test.skip>
        <!-- Token 头部约定（与 SQLBot 前端逐字兼容） -->
        <java.version>1.8</java.version>
        <!-- 平台：Java8 / Spring Boot 2.7（fw-plus 0.1.1 线） -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <!-- 统一版本属性：fw-plus 与 Spring Boot 各只此一处，供全 POM 引用 -->
        <revision>0.1.1-SNAPSHOT</revision>
        <spring-boot.version>2.7.18</spring-boot.version>
        <justauth.version>1.16.6</justauth.version>
        <justauth-spring-boot-starter.version>1.4.0</justauth-spring-boot-starter.version>
        <!-- 通用文件存储（对齐 SQLBot 文件存储）：本地默认，可配置切 OSS/MinIO 等 -->
        <x-file-storage.version>2.2.1</x-file-storage.version>
        <!-- 对象存储 SDK：x-file-storage 的平台实现按 classpath 激活（MinIO / 阿里云 OSS / 腾讯云 COS） -->
        <minio.version>8.5.17</minio.version>
        <aliyun-oss.version>3.18.5</aliyun-oss.version>
        <tencent-cos.version>5.6.247</tencent-cos.version>
        <aws-s3.version>1.12.794</aws-s3.version>
    </properties>


    <dependencyManagement>
        <dependencies>
            <!-- fw-plus 全家桶统一版本管理：三个 BOM 各管一层，版本只在 <properties><revision> 一处维护。
                 fw-plus-ai-boot-dependencies → fw-plus-ai-boot-*、MCP starter，并聚合后两个 BOM
                                               （含 spring-boot-dependencies / langchain4j-bom / jackson-bom）
                 fw-plus-boot-dependencies    → fw-plus-boot-*
                 fw-plus-dependencies         → auth / common / redis / template / easytrans / poi / mp / mf / mybatis 等 -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-dependencies</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 鉴权（D10）：复用 fw-plus-auth-satoken 封装（含其 SaToken 惯例类与 cn.dev33 版本 1.46.0）。 -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-auth-satoken</artifactId>
        </dependency>
        <!-- Sa-Token：Spring Boot 2.7 / javax 线必须用 SB2 变体。
             boot3 变体会传递引入 sa-token-jakarta-servlet 与 jakarta.servlet-api 6.0.0
             （major 55，JDK 8 加载即抛 UnsupportedClassVersionError）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot-starter</artifactId>
        </dependency>

        <!-- 注：不再直接依赖 fw-plus-ai-model（原 AiChatModel 契约已移除，ChatModelClient 改为自包含
             OpenAI 兼容客户端）。该构件仍由 fw-plus MCP starter 传递引入，版本在下方 dependencyManagement 锁定。 -->

        <!-- langchain4j 模型接入（AssistantBuilder 所需 ChatModel/StreamingChatModel/EmbeddingModel；OpenAI 兼容） -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j-openai</artifactId>
            <!-- fw-plus-dependencies 未收录该构件，版本单独声明 -->
            <version>${revision}</version>
        </dependency>
        <!-- 缓存层：Spring Cache 抽象（后端由 askdata.cache.type 决定：memory / redis / none） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <!-- 缓存后端：进程内 Caffeine（askdata.cache.type=memory） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- 缓存后端：Redis（askdata.cache.type=redis / sa-token-store=redis 时使用；连接参数走 spring.data.redis.*） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Sa-Token 会话存储：Redis 实现（askdata.cache.sa-token-store=redis 时启用；
             其自动配置只装配实例，需由 SaTokenStoreInitializer 显式注册给 SaManager） -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-template</artifactId>
        </dependency>

        <!-- MCP server（复用 fw-plus 封装 fw-plus-ai-mcp-server-spring-boot-starter，取代手写 JSON-RPC）。
             与 askdata 同在 Java8 / SpringBoot 2.7.18 / fw-plus ${revision} 线；
             经 fw-plus-ai-boot-starter 传递引入 fw-plus-ai-boot-autoconfigure（含 AssistantBuilder 与 McpAutoConfiguration）。 -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus.ai</groupId>
            <artifactId>fw-plus-ai-mcp-server-spring-boot-starter</artifactId>
        </dependency>

        <!-- Web 层与 JDBC（元数据库 H2；skeleton 期以 JdbcTemplate 访问登录必需表） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Actuator：提供 /health 等生产就绪端点（对齐外部探针 path=/health）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- AOP 支撑审计切面 @AuditLog（对齐 SQLBot @system_log 装饰器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 元数据库版本化迁移（A9）：common 种子 + h2/postgresql/mysql 方言 baseline。
             方言模块由 Flyway 按 JDBC URL 自动匹配，切换元数据库只需改连接配置。 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- SQL 解析（A5：SQL 安全升级为 sqlglot 等价的 AST 校验；A3：行权限 WHERE 注入） -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <!-- 必须显式锁定 4.9：BOM 管理的 4.6 是旧 AST 模型（SelectBody/SubSelect），
                 4.9 已是 5.x 的统一模型（PlainSelect extends Select）且仍是 Java 8 字节码（major 52）。 -->
            <version>4.9</version>
        </dependency>

        <!-- 通用文件存储 x-file-storage（对齐 SQLBot 文件存储）：本地默认、可配置切 OSS/MinIO 等；
             cn.hutool 由项目已有的 hutool-all 提供，排除 hutool-core 避免重复类 -->
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-core</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>cn.hutool</groupId>
                    <artifactId>hutool-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-spring</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>cn.hutool</groupId>
                    <artifactId>hutool-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 对象存储平台 SDK（A18/A19/A20）：x-file-storage 依据 classpath 激活对应平台实现；
             未配置平台凭据时不会发起连接，也不影响默认 local 平台启动 -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
        </dependency>
        <dependency>
            <groupId>com.qcloud</groupId>
            <artifactId>cos_api</artifactId>
        </dependency>
        <!-- 通用 S3 兼容对象存储（A22）：x-file-storage amazon-s3 平台使用 AWS SDK v1 -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-java-sdk-s3</artifactId>
        </dependency>

        <!-- 数据源引擎 JDBC 驱动（A8：mysql/pg/h2/sqlite 随包提供；
             oracle/mssql/clickhouse/hive/kingbase/dm 一并进入 runtime，前端可选即可用） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- sqlite 驱动：optional 仅编译/测试期可见（运行时放扩展目录，不进 fat jar） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <optional>true</optional>
        </dependency>

        <!-- 真实环境方言验证驱动（runtime，随包提供）。
             Oracle XE 21c / SQL Server 2022 真实连通与元数据/预览 SQL 验收所需。
             版本必须选 Java 8 字节码（major 52）的构件：ojdbc11 / mssql-jdbc *.jre11
             均为 major 55，JDK 8 加载即抛 UnsupportedClassVersionError。 -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <version>21.5.0.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>10.2.3.jre8</version>
            <scope>runtime</scope>
        </dependency>

        <!-- A8：六类数据源驱动进入 runtime（前端可选即可用）。
             Oracle / SQLServer 由上方 test scope 调整为 runtime；ClickHouse / Hive /
             Kingbase / 达梦为本次新增。SQLBot pyproject 同样打包这些驱动。 -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>0.6.3</version>
            <scope>runtime</scope>
            <classifier>all</classifier>
        </dependency>
        <dependency>
            <groupId>org.apache.hive</groupId>
            <artifactId>hive-jdbc</artifactId>
            <version>3.1.3</version>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.hadoop</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.hive</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jdk.tools</groupId>
                    <artifactId>jdk.tools</artifactId>
                </exclusion>
                <!-- libthrift 0.21.0 传递引入 jakarta.servlet-api 6.0.0（major 55，JDK 8 无法加载），
                     且与 Spring Boot 2.7 的 javax.servlet 命名空间冲突。 -->
                <exclusion>
                    <groupId>jakarta.servlet</groupId>
                    <artifactId>jakarta.servlet-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.com.kingbase</groupId>
            <artifactId>kingbase8</artifactId>
            <version>8.6.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
            <version>8.1.3.140</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Excel 上传/解析/建表/导出（对齐 SQLBot apps/datasource/utils/excel.py）
             + 训练/术语/提示词/审计的导入导出；
             Apache POI 版本不受 Spring Boot BOM 管理（BOM 的 poi 4.1.2 与 poi-ooxml 5.2.3 不兼容），
             此处显式锁定 Java 8 兼容的 5.2.3 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <!-- 必须显式锁定：BOM 管理的 4.1.2 与 poi-ooxml 不兼容，且缺 poi-ooxml-lite -->
            <version>5.2.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A9：PostgreSQL 元数据库真库测试（进程内临时实例，不需要 Docker/本机 psql） -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.1.0</version>
            <scope>test</scope>
        </dependency>

        <!-- LDAP 真 bind 端到端测试（A2）：进程内 LDAP 服务（随机端口、真实 TCP），
             验证 LdapSsoClient 的 JNDI simple bind 全链路（服务账号 bind → 搜索用户 DN →
             用户 DN bind 校验口令 → 读属性映射）。仅 test 范围，不进产物。 -->
        <dependency>
            <groupId>com.unboundid</groupId>
            <artifactId>unboundid-ldapsdk</artifactId>
            <version>7.0.5</version>
            <scope>test</scope>
        </dependency>

        <!-- 本地 embedding 模型（D8/A6）：ONNX Runtime 驱动 shibing624_text2vec-base-chinese
             （768 维归一化）。模型权重不进 git（793MB），运行时从可配置目录加载
             （askdata.embedding.model-path，默认 /opt/askdata/models）；
             模型缺失/加载失败时 ai/LocalEmbeddingModel 降级为不可用，
             向量召回回落词法，问数主链路不报错。 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
        </dependency>
        <!-- SSO 第三方授权（brief D9）：JustAuth 统一抽象授权跳转/回调/用户信息。
             坐标以本机 ~/.m2 实际存在者为准：me.zhyd.oauth:JustAuth。
             justauth-spring-boot-starter 传递的 hutool-core:5.6.5 本机缺失，改由项目已有的
             hutool-all:5.8.47 提供。 -->
        <dependency>
            <groupId>me.zhyd.oauth</groupId>
            <artifactId>JustAuth</artifactId>
            <version>${justauth.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xkcoding.justauth</groupId>
            <artifactId>justauth-spring-boot-starter</artifactId>
            <version>${justauth-spring-boot-starter.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>cn.hutool</groupId>
                    <artifactId>hutool-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>me.zhyd.oauth</groupId>
                    <artifactId>JustAuth</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- API 文档：Knife4j UI（/doc.html）+ springdoc（/v3/api-docs 规范）。
             只取 knife4j 的静态 UI 构件：UI 本身是纯前端静态资源（META-INF/resources/doc.html
             + /webjars/**），直接读 /v3/api-docs/swagger-config 分组，不需要 starter 的自动配置。
             springdoc 必须用 v1 线（springdoc-openapi-ui 1.7.0）：v2 的
             springdoc-openapi-starter-* 2.2.0 是 Java 17 字节码（major 61），且面向 Spring Boot 3。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-ui</artifactId>
            <version>4.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
            <version>1.7.0</version>
        </dependency>

    </dependencies>

    <!--
      JustAuth 构件本地缓存来源仓库 ID（离线构建命中本地缓存，不触发网络）。
    -->
    <repositories>
        <repository>
            <id>alimaven</id>
            <name>aliyun maven (cached source of JustAuth)</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun</id>
            <name>aliyun maven (cached source of justauth-spring-boot-starter)</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 显式声明以支持 JUnit 5（Maven 默认 surefire 2.12.4 不识别 junit-platform） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <finalName>askdata-server</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <!-- 构建版本文件需参与过滤（注入 @project.version@），故在此排除、由下方条目单独处理 -->
                    <exclude>askdata-build.properties</exclude>
                </excludes>
            </resource>
            <!-- 仅构建版本文件参与资源过滤：application.yaml 里大量 ${...} 占位符不能被 Maven 解析 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>askdata-build.properties</include>
                </includes>
            </resource>
            <!-- 前端构建产物挂入静态资源（A2 托管约定：web/dist → BOOT-INF/classes/static） -->
            <resource>
                <directory>web/dist</directory>
                <targetPath>static</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 显式声明 surefire 版本：BOM import 不传递插件管理，默认 2.12.4 不支持 JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.xiongx9527.askdata.AskDataApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-test</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 前端自动构建：mvn package 前用系统 npm 构建 web/dist 并打进 jar 静态资源。
                 绑定 prepare-package（在 spring-boot:run 的 test-compile 之后、jar 打包之前），
                 因此 mvn -o spring-boot:run 离线启动不会触发联网的 npm install，
                 本地开发仍由 process-resources 阶段的 resources 拷贝既有 web/dist 提供静态资源。 -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>web</workingDirectory>
                    <npmInheritsProxyConfigFromMaven>false</npmInheritsProxyConfigFromMaven>
                </configuration>
                <executions>
                    <execution>
                        <id>frontend-npm-install</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-npm-build</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 前端构建完成后，将最新 web/dist 覆拷进 target/classes/static（jar 静态资源源） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>web/dist</directory>
                                    <filtering>false</filtering>
