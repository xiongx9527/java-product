<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiongx9527</groupId>
        <artifactId>askdata</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>askdata-server</artifactId>
    <packaging>jar</packaging>

    <name>askdata server</name>
    <description>问数单体后端（Spring Boot 3.5.8，前后端一体：前端 dist 经资源目录挂入 static）。</description>

    <properties>
        <maven.test.skip>true</maven.test.skip>
        <!-- Token 头部约定（与 SQLBot 前端逐字兼容） -->
        <java.version>17</java.version>
        <!-- 平台迁移 Java17/SB3.5/Jakarta：覆盖根 POM 的 8 -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- 统一版本属性：fw-plus 与 Spring Boot 各只此一处，供全 POM 引用 -->
        <revision>0.3.0-SNAPSHOT</revision>
        <spring-boot.version>3.5.8</spring-boot.version>
        <justauth.version>1.16.6</justauth.version>
        <justauth-spring-boot-starter.version>1.4.0</justauth-spring-boot-starter.version>
        <!-- 通用文件存储（对齐 SQLBot 文件存储）：本地默认，可配置切 OSS/MinIO 等 -->
        <x-file-storage.version>2.2.1</x-file-storage.version>
    </properties>


    <dependencyManagement>
        <dependencies>
            <!-- fw-plus MCP starter 传递闭包：统一用 ${revision}（覆盖父 BOM 误导向的 0.3.0-SNAPSHOT），版本号仅 revision 一处 -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-ai-langchain4j-nebula</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-ai-langchain4j-neo4j</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-ai-mcp-server</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-ai-langchain4j-openai</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-annotation</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-auth-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-auth-satoken</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-dify</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-easytrans-annotation</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-easytrans-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-easytrans-service</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-magicapi</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mf-datachange</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mf-datascope</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mf-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mp-base</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mp-datachange</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mp-datascope</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mp-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mp-join</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mybatis-datachange</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mybatis-datascope</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-mybatis-encrypt</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-poi-easypoi</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-redis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-template</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot-autoconfigure</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-mcp-server-spring-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-autoconfigure</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-common</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-magicapi-spring-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 鉴权（D10）：优先复用 fw-plus-auth-satoken 封装（含其 SaToken 惯例类与 cn.dev33 版本 1.46.0） -->
        <!-- 鉴权（D10）：复用 fw-plus-auth-satoken 封装（SB3/Jakarta 原生，经其传递引入匹配的 sa-token-spring-boot3-starter）。
             不再显式引入 SB2 变体 sa-token-spring-boot-starter（会在 SpringBoot 3.5 上抛不兼容异常）。 -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-auth-satoken</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Sa-Token：SpringBoot 3.x/Jakarta 必须用 boot3 变体（SB2 的 sa-token-spring-boot-starter 在 3.5 抛不兼容）。 -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- 注：不再直接依赖 fw-plus-ai-model（原 AiChatModel 契约已移除，ChatModelClient 改为自包含
             OpenAI 兼容客户端）。该构件仍由 fw-plus MCP starter 传递引入，版本在下方 dependencyManagement 锁定。 -->

        <!-- langchain4j 实验 NL2SQL：SqlDatabaseContentRetriever（问数 RAG：schema→生成SQL→执行） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-experimental-sql</artifactId>
            <version>1.22.0-beta32</version>
        </dependency>
        <!-- langchain4j agentic（框架 Assistant/技能/意图路由所需 AgenticScopeStore） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-agentic</artifactId>
            <version>1.22.0-beta32</version>
        </dependency>
        <!-- langchain4j 模型接入（AssistantBuilder 所需 ChatModel/StreamingChatModel/EmbeddingModel；OpenAI 兼容） -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-langchain4j-openai</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- langchain4j 在线向量库后端：Qdrant（复用 langchain4j 的 QdrantEmbeddingStore gRPC 封装，
             作为 askdata.vector-store.type=qdrant 时的向量存储与 ANN 检索后端；type=none 时经 DbVectorStore 回落）。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-qdrant</artifactId>
            <version>1.22.0-beta32</version>
        </dependency>
        <!-- langchain4j 在线向量库后端：Milvus（复用 langchain4j 的 MilvusEmbeddingStore，
             作为 askdata.vector-store.type=milvus 时的向量存储与 ANN 检索后端；不可达时经 DbVectorStore 回落）。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-milvus</artifactId>
            <version>1.22.0-beta32</version>
        </dependency>
        <!-- MCP server（复用 fw-plus 封装 fw-plus-ai-mcp-server-spring-boot-starter，取代手写 JSON-RPC）。
             与 askdata 同在 Java8 / SpringBoot 2.7.18 / fw-plus ${revision} 线；
             经 fw-plus-ai-boot-starter 传递引入 fw-plus-ai-boot-autoconfigure（含 AssistantBuilder 与 McpAutoConfiguration）。 -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus.ai</groupId>
            <artifactId>fw-plus-ai-mcp-server-spring-boot-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Web 层与 JDBC（元数据库 H2；skeleton 期以 JdbcTemplate 访问登录必需表） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- AOP 支撑审计切面 @AuditLog（对齐 SQLBot @system_log 装饰器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- SQL 解析（A5：SQL 安全升级为 sqlglot 等价的 AST 校验；A3：行权限 WHERE 注入） -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>5.1</version>
        </dependency>

        <!-- 通用文件存储 x-file-storage（对齐 SQLBot 文件存储）：本地默认、可配置切 OSS/MinIO 等；
             cn.hutool 由项目已有的 hutool-all 提供，排除 hutool-core 避免重复类 -->
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-core</artifactId>
            <version>${x-file-storage.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>cn.hutool</groupId>
                    <artifactId>hutool-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-spring</artifactId>
            <version>${x-file-storage.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>cn.hutool</groupId>
                    <artifactId>hutool-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 数据源引擎 JDBC 驱动（brief D6：mysql/h2/pg 为首选全集，随包提供；
             其余类型驱动按 README「JDBC 驱动扩展目录」约定外置，不打进 jar） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- sqlite 驱动：optional 仅编译/测试期可见（运行时放扩展目录，不进 fat jar） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <optional>true</optional>
        </dependency>

        <!-- 真实环境方言验证驱动（test 范围，仅集成测试使用；不打进产物）。
             Oracle XE 21c / SQL Server 2022 真实连通与元数据/预览 SQL 验收所需。 -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>21.9.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>12.10.2.jre11</version>
            <scope>test</scope>
        </dependency>

        <!-- Excel 上传/解析/建表/导出（对齐 SQLBot apps/datasource/utils/excel.py）
             + 训练/术语/提示词/审计的导入导出；
             Apache POI 版本不受 Spring Boot BOM 管理（BOM 的 poi 4.1.2 与 poi-ooxml 5.2.3 不兼容），
             此处显式锁定 Java 8 兼容的 5.2.3 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 本地 embedding 模型（D8/A6）：ONNX Runtime 驱动 shibing624_text2vec-base-chinese
             （768 维归一化）。模型权重不进 git（793MB），运行时从可配置目录加载
             （askdata.embedding.model-path，默认 /opt/askdata/models）；
             模型缺失/加载失败时 ai/LocalEmbeddingModel 降级为不可用，
             向量召回回落词法，问数主链路不报错。 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
        </dependency>
        <!-- SSO 第三方授权（brief D9）：JustAuth 统一抽象授权跳转/回调/用户信息。
             坐标以本机 ~/.m2 实际存在者为准：me.zhyd.oauth:JustAuth。
             justauth-spring-boot-starter 传递的 hutool-core:5.6.5 本机缺失，改由项目已有的
             hutool-all:5.8.47 提供。 -->
        <dependency>
            <groupId>me.zhyd.oauth</groupId>
            <artifactId>JustAuth</artifactId>
            <version>${justauth.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xkcoding.justauth</groupId>
            <artifactId>justauth-spring-boot-starter</artifactId>
            <version>${justauth-spring-boot-starter.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>cn.hutool</groupId>
                    <artifactId>hutool-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>me.zhyd.oauth</groupId>
                    <artifactId>JustAuth</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- API 文档：Knife4j UI（/doc.html）+ springdoc（/v3/api-docs 规范）。
             只取 knife4j 的静态 UI 构件：starter 4.5.0 的 Knife4jOpenApiCustomizer 按 springdoc 2.3.0
             的 SpringDocConfigProperties.getGroupConfigs():List 编译，在 2.5+ 改成 Set 后会抛
             NoSuchMethodError，而 springdoc 2.3.0 又不兼容 Spring Boot 3.5.x，两者不可兼得。
             UI 本身是纯前端静态资源（META-INF/resources/doc.html + /webjars/**），直接读
             /v3/api-docs/swagger-config 分组，不需要 starter 的自动配置。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-ui</artifactId>
            <version>4.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.17</version>
        </dependency>

    </dependencies>

    <!--
      JustAuth 构件本地缓存来源仓库 ID（离线构建命中本地缓存，不触发网络）。
    -->
    <repositories>
        <repository>
            <id>alimaven</id>
            <name>aliyun maven (cached source of JustAuth)</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>aliyun</id>
            <name>aliyun maven (cached source of justauth-spring-boot-starter)</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 显式声明以支持 JUnit 5（Maven 默认 surefire 2.12.4 不识别 junit-platform） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <finalName>askdata-server</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- 前端构建产物挂入静态资源（A2 托管约定：web/dist → BOOT-INF/classes/static） -->
            <resource>
                <directory>web/dist</directory>
                <targetPath>static</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 显式声明 surefire 版本：BOM import 不传递插件管理，默认 2.12.4 不支持 JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.xiongx9527.askdata.AskDataApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-test</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
