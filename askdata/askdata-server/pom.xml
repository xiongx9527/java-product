<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiongx9527.askdata</groupId>
        <artifactId>askdata</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>askdata-server</artifactId>
    <packaging>jar</packaging>

    <name>askdata server</name>
    <description>问数单体后端（Spring Boot 2.7.18，前后端一体：前端 dist 经资源目录挂入 static）。</description>

    <properties>
        <maven.test.skip>true</maven.test.skip>
        <!-- Token 头部约定（与 SQLBot 前端逐字兼容） -->
        <java.version>8</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- fw-plus Boot 依赖库（内含 spring-boot 2.7.18 / sa-token / h2 / mybatis-plus 等版本管理链） -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-dependencies</artifactId>
                <version>0.1.1-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- fw-plus AI 依赖库（chat/模型接入相关，本期 skeleton 预留） -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus.ai</groupId>
                <artifactId>fw-plus-ai-boot-dependencies</artifactId>
                <version>0.1.1-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 鉴权（D10）：优先复用 fw-plus-auth-satoken 封装（含其 SaToken 惯例类与 cn.dev33 版本 1.46.0） -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-auth-satoken</artifactId>
            <version>0.1.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot-starter</artifactId>
            <version>1.46.0</version>
        </dependency>

        <!-- Web 层与 JDBC（元数据库 H2；skeleton 期以 JdbcTemplate 访问登录必需表） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Excel 导入导出（训练/术语/提示词/审计；BOM 将 poi 管理到 4.1.2 与 poi-ooxml 5.2.3 不兼容，
             此处显式锁定同版本，取 Java 8 兼容的 5.2.3） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>askdata-server</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- 前端构建产物挂入静态资源（A2 托管约定：web/dist → BOOT-INF/classes/static） -->
            <resource>
                <directory>web/dist</directory>
                <targetPath>static</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 显式声明 surefire 版本：BOM import 不传递插件管理，默认 2.12.4 不支持 JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>2.7.18</version>
                <configuration>
                    <mainClass>com.xiongx9527.askdata.AskDataApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-test</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
