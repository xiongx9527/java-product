<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiongx9527</groupId>
        <artifactId>askdata</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>askdata-server</artifactId>
    <packaging>jar</packaging>

    <name>askdata server</name>
    <description>问数单体后端（Spring Boot 2.7.18，前后端一体：前端 dist 经资源目录挂入 static）。</description>

    <properties>
        <maven.test.skip>true</maven.test.skip>
        <!-- Token 头部约定（与 SQLBot 前端逐字兼容） -->
        <java.version>8</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- fw-plus Boot 依赖库（内含 spring-boot 2.7.18 / sa-token / h2 / mybatis-plus 等版本管理链）；
                 根 POM 现已继承 fw-plus-ai-build（→ fw-plus-boot-parent → 本 BOM），此处保留显式 import 以稳定 boot starter 版本。 -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus.boot</groupId>
                <artifactId>fw-plus-boot-dependencies</artifactId>
                <version>0.1.1-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 显式锁定 askdata 依赖的普通 fw-plus 业务模块版本（0.1.1-SNAPSHOT 线，与 auth-satoken/ai-model 一致）。
                 继承链中的 fw-plus-dependencies BOM 会把这些模块解析到本地仓库缺失的 0.1.0-SNAPSHOT，
                 此处用最近的 dependencyManagement 覆盖回 0.1.1-SNAPSHOT。 -->
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-auth-core</artifactId>
                <version>0.1.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-common</artifactId>
                <version>0.1.1-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.xiongx9527.fw.plus</groupId>
                <artifactId>fw-plus-annotation</artifactId>
                <version>0.1.1-SNAPSHOT</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 鉴权（D10）：优先复用 fw-plus-auth-satoken 封装（含其 SaToken 惯例类与 cn.dev33 版本 1.46.0） -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-auth-satoken</artifactId>
            <version>0.1.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot-starter</artifactId>
            <version>1.46.0</version>
        </dependency>

        <!-- 模型接入（brief 引擎约束：由 fw-plus-ai 承担；chat-core 实现其 AiChatModel 契约） -->
        <dependency>
            <groupId>com.xiongx9527.fw.plus</groupId>
            <artifactId>fw-plus-ai-model</artifactId>
            <version>0.1.1-SNAPSHOT</version>
        </dependency>

        <!-- Web 层与 JDBC（元数据库 H2；skeleton 期以 JdbcTemplate 访问登录必需表） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 数据源引擎 JDBC 驱动（brief D6：mysql/h2/pg 为首选全集，随包提供；
             其余类型驱动按 README「JDBC 驱动扩展目录」约定外置，不打进 jar） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- sqlite 驱动：optional 仅编译/测试期可见（运行时放扩展目录，不进 fat jar） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <optional>true</optional>
        </dependency>

        <!-- Excel 上传/解析/建表/导出（对齐 SQLBot apps/datasource/utils/excel.py）
             + 训练/术语/提示词/审计的导入导出；
             Apache POI 版本不受 Spring Boot BOM 管理（BOM 的 poi 4.1.2 与 poi-ooxml 5.2.3 不兼容），
             此处显式锁定 Java 8 兼容的 5.2.3 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 显式声明以支持 JUnit 5（Maven 默认 surefire 2.12.4 不识别 junit-platform） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>2.22.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <finalName>askdata-server</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <!-- 前端构建产物挂入静态资源（A2 托管约定：web/dist → BOOT-INF/classes/static） -->
            <resource>
                <directory>web/dist</directory>
                <targetPath>static</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- 显式声明 surefire 版本：BOM import 不传递插件管理，默认 2.12.4 不支持 JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>2.7.18</version>
                <configuration>
                    <mainClass>com.xiongx9527.askdata.AskDataApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-starter-test</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
