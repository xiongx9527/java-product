<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiongx9527.fw.plus.ai</groupId>
        <artifactId>fw-plus-ai-build</artifactId>
        <version>0.1.1-SNAPSHOT</version>
    </parent>

    <groupId>com.xiongx9527</groupId>
    <artifactId>java-product</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Java Product Root</name>
    <description>Java 产品根聚合 POM：通用聚合根，容纳 askdata 及后续项目；继承 fw-plus-ai-build 以统一接管 fw-plus-ai 依赖与版本管理（无本地源码 relativePath，父 POM 来自本地仓库）。</description>

    <modules>
        <module>askdata</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <revision>0.1.1-SNAPSHOT</revision>
        <!--跳过test-->
        <maven.test.skip>true</maven.test.skip>
        <!--跳过javadoc生成-->
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <!--跳过install-->
        <maven.install.skip>true</maven.install.skip>
        <!--跳过deploy-->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>
</project>
