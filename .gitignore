# Build outputs
target/
node_modules/
data/
*.trace.db
*.mv.db

# dist 默认不提交；唯一例外：web/dist 为 A2 托管产物（jar 静态资源源），必须提交
dist/
!askdata/askdata-server/web/dist/
!askdata/askdata-server/web/dist/**

# IDE / OS
.idea/
*.iml
.DS_Store

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
# >>> Comet managed project state >>>
!/.comet/
/.comet/*
!/.comet/config.yaml
